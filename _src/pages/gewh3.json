size:87px; line-height:normal; text-align:center\"><span style=\"font-size:87px\"><span style=\"letter-spacing:normal\">Week10</span></span></h1>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-mml9c66t":{"type":"StyledText","id":"dataItem-mml9c66t","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"ldx-6696"},"text":"<p class=\"font_8\" style=\"line-height:normal\"><span class=\"color_36\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">This is the how the final video looks like for shot3.</span></span></span></span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-mml9c66t6":{"type":"VideoPlayer","id":"dataItem-mml9c66t6","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"ldx-6744"},"videoRef":"#dataItem-mmlrbgmt","videoTitle":"Your Video Title","description":"","videoType":"file"},"dataItem-mmlrbgmt":{"type":"WixVideo","id":"dataItem-mmlrbgmt","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"ldx-6745"},"title":"SHOT03_Layout_v3.mp4","videoId":"f7279b_929661cf9bab44a8810a3e5a0f0807ce","qualities":[{"quality":"1080p","width":1920,"height":1080,"url":"video/f7279b_929661cf9bab44a8810a3e5a0f0807ce/1080p/mp4/file.mp4"},{"quality":"720p","width":1280,"height":720,"url":"video/f7279b_929661cf9bab44a8810a3e5a0f0807ce/720p/mp4/file.mp4"},{"quality":"480p","width":854,"height":480,"url":"video/f7279b_929661cf9bab44a8810a3e5a0f0807ce/480p/mp4/file.mp4"},{"quality":"360p","width":640,"height":360,"url":"video/f7279b_929661cf9bab44a8810a3e5a0f0807ce/360p/mp4/file.mp4"},{"quality":"storyboard","width":256,"height":144,"url":"video/f7279b_929661cf9bab44a8810a3e5a0f0807ce/storyboard/144p/mp4/file.mp4"}],"posterImageRef":"#dataItem-mmlrbgmt1","opacity":1.0,"duration":10.04,"preload":"auto","artist":{"id":"","name":""},"generatedPosters":["f7279b_929661cf9bab44a8810a3e5a0f0807cef000.jpg","f7279b_929661cf9bab44a8810a3e5a0f0807cef001.jpg","f7279b_929661cf9bab44a8810a3e5a0f0807cef002.jpg","f7279b_929661cf9bab44a8810a3e5a0f0807cef003.jpg"],"hasAudio":true,"fps":"24/1","adaptiveVideo":[{"format":"hls","url":"site/media/video/f7279b_929661cf9bab44a8810a3e5a0f0807ce/be151871-7e06-4975-982b-207a3dcf8d4e/repackage/hls"}],"mediaFeatures":[]},"dataItem-mmlrbgmt1":{"type":"Image","id":"dataItem-mmlrbgmt1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"1r7-13"},"title":"","uri":"f7279b_929661cf9bab44a8810a3e5a0f0807cef000.jpg","description":"private","width":1920,"height":1080,"alt":""},"dataItem-mmlsx53u":{"type":"StyledText","id":"dataItem-mmlsx53u","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"1r7-1233"},"text":"<p class=\"font_8\" style=\"line-height: normal;\"><a dataquery=\"#textLink_mmlsxjnx\"><span style=\"font-weight:normal;\"><span style=\"font-family:futura-lt-w01-book,sans-serif;\"><span class=\"color_36\"><span style=\"text-decoration:underline;\"><span style=\"letter-spacing:normal;\">https://docs.google.com/document/d/1hOJg3FUuhXfXVVqxgR9DVC_2Fe2HccDd-mshbxqo3hI/edit?tab=t.av4iqfyrotly</span></span></span></span></span></a></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":["#textLink_mmlsxjnx"]},"dataItem-mmlsxmxq":{"type":"StyledText","id":"dataItem-mmlsxmxq","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"1r7-1866"},"text":"<p class=\"font_8\" style=\"line-height:normal\"><span class=\"color_36\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">This is the pipeline summary for the first quarter (VAT vs. USD):</span></span></span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-mmlsymah":{"type":"StyledText","id":"dataItem-mmlsymah","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"1r7-1874"},"text":"<p class=\"font_8\" style=\"font-size: 31px; line-height: normal;\"><span style=\"font-size:31px;\"><span class=\"color_36\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">Plan for next quarter:</span></span></span></span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-mmlt18yo":{"type":"StyledText","id":"dataItem-mmlt18yo","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"1r7-34483"},"text":"<ul class=\"font_8 color_36\" style=\"font-family:futura-lt-w01-book,sans-serif; font-weight:normal\">\n\t<li>\n\t<p class=\"font_8\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">Pipeline Development</span></span><br />\n\t<span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">Yichen will focus on studying the real growth behavior of grape hyacinth. Based on that reference, I will continue developing the pipeline between Houdini and Unreal Engine using VAT.</span></span></span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">Shader Exploration</span></span><br />\n\t<span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">Danci has already built the master shader. Based on that setup, I will further explore texture development in Substance 3D Designer and Substance 3D Painter to refine subtle color variation, subsurface scattering (SSS), and roughness differences in grape hyacinth.</span></span></span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">Interaction Development</span></span><br />\n\t<span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">Interaction will be reintroduced into the project, likely through TouchDesigner in collaboration with Danci. One direction is allowing users to control plant growth through hand interaction. Another possibility is building interaction directly in Unreal Engine, where plant animation is triggered when users move close to the environment. The interaction concept will also connect to seasonal change.</span></span></span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">FX Integration</span></span><br />\n\t<span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">Particle effects will also be added to the project by transferring simulations from Houdini into Unreal Engine. I will explore combining VAT with Niagara so the particles can be controlled in real time and respond to interaction inside the environment.</span></span></span></p>\n\t</li>\n\t<li>\n\t<p class=\"font_8\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">Asset Expansion</span></span><br />\n\t<span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span class=\"color_36\">At the current stage, grape hyacinth is the primary tested asset. Further evaluation is needed to determine whether additional plant assets are required to support the environment and seasonal variation.</span></span></span></p>\n\t</li>\n</ul>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-mmn5l556":{"type":"StyledText","id":"dataItem-mmn5l556","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"1r7-36483"},"text":"<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">10-Week Plan&nbsp;</span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-size:20px\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">Week 1 </span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">&ndash; Refine grape hyacinth shader in Substance 3D Painter and Substance 3D Designer, focusing on subtle color variation and petal detail.</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"><span style=\"font-size:20px\">Week 2</span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"> &ndash; Continue shader testing in Unreal Engine, adjusting subsurface scattering (SSS), roughness, translucency, and master material response under different lighting conditions.</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"><span style=\"font-size:20px\">Week 3</span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"> &ndash; Finalize shader workflow and organize texture/material pipeline for grape hyacinth asset variants.</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"><span style=\"font-size:20px\">Week 4 </span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">&ndash; Begin particle FX tests in Houdini, focusing on simple particle motion and controllable flow behavior.</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"><span style=\"font-size:20px\">Week 5</span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"> &ndash; Export particle animation through VAT and test transfer into Unreal Engine.</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"><span style=\"font-size:20px\">Week 6</span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"> &ndash; Combine VAT with Niagara to test real-time particle instancing and interactive control.</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"><span style=\"font-size:20px\">Week 7 </span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">&ndash; Refine Niagara behavior and explore how particle effects respond to user interaction.</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"><span style=\"font-size:20px\">Week 8</span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"> &ndash; Explore Niagara control for interactive particle response.</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"><span style=\"font-size:20px\">Week 9 </span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">&ndash; Build trigger-based interaction in Unreal Engine so particle or plant animation responds when users approach the environment. </span></span></span></span><span style=\"color:#FF0000\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">？？？</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#FF0000\"><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"line-height:normal\"><span style=\"color:#1FDF67\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\"><span style=\"font-size:20px\">Week 10 </span></span></span><span style=\"font-weight:normal\"><span style=\"font-family:futura-lt-w01-book,sans-serif\"><span style=\"letter-spacing:normal\">&ndash; Integrate shader, particle FX, and interaction into a unified small-scale environment test.</span></span></span></span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"gewh3":{"type":"Page","id":"gewh3","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"ldx-1573"},"title":"Week10","hideTitle":true,"icon":"","descriptionSEO":"","metaKeywordsSEO":"","pageTitleSEO":"","pageUriSEO":"copy-of-week9-2","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false},"isPopup":false,"indexable":true,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#dataItem-mml9c66i","isPreset":true},"mobile":{"custom":true,"ref":"#dataItem-mm